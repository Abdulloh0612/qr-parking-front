# Backend API base URL (without /api/v1 suffix). Baked into the bundle at build time only.
# Empty or "/" = same origin /api/v1 (nginx must proxy /api/ to the backend).
#
# Local dev (copy to .env):
# VITE_API_URL=http://localhost:8090
#
# Production build uses .env.production — edit it before `npm run build`, do not rely on
# runtime .env on the server (Vite does not read it in the browser).
